{
  "configVersion": "v3",
  "app": {
    "appId": 20001,
    "appName": "Radio Reloj",
    "appType": "app",
    "version": {
      "code": 2,
      "name": "1.1.0"
    },
    "icon": "icon.png",
    "vender": "radioreloj",
    "description": "Elige una emisora en el reloj y escúchala en el móvil"
  },
  "permissions": ["data:os.device.info", "device:os.local_storage"],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.0"
    }
  },
  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": ["page/home/index.page", "page/player/index.page"]
        },
        "app-side": {
          "path": "app-side/index"
        }
      },
      "platforms": [
        {
          "st": "s",
          "dw": 390
        }
      ]
    }
  },
  "i18n": {
    "es-ES": {
      "appName": "Radio Reloj"
    },
    "en-US": {
      "appName": "Radio Reloj"
    }
  },
  "defaultLanguage": "es-ES"
}
